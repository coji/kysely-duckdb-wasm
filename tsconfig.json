{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    // tsup's .d.ts build injects the now-deprecated `baseUrl` option. Silence the
    // TypeScript 6.0 deprecation error (option is removed in 7.0) during the build.
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.cjs", "./tests/**/*.ts"]
}
