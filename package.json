{
  "name": "@coji/kysely-duckdb-wasm",
  "version": "0.3.0",
  "description": "kysely dialect for duckdb wasm",
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "build": "tsdown",
    "format": "prettier . --check --experimental-cli",
    "format:fix": "prettier . --write --experimental-cli",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "validate": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build && pnpm run docs"
  },
  "keywords": [
    "kysely",
    "kysely-dialect",
    "duckdb",
    "duckdb-wasm"
  ],
  "author": "coji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coji/kysely-duckdb-wasm.git"
  },
  "homepage": "https://github.com/coji/kysely-duckdb-wasm#readme",
  "bugs": {
    "url": "https://github.com/coji/kysely-duckdb-wasm/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@types/node": "^24.13.1",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "apache-arrow": "^17.0.0",
    "kysely": "^0.29.2",
    "playwright": "1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "tsdown": "^0.22.2",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "*",
    "apache-arrow": "*",
    "kysely": "^0.28 || ^0.29"
  }
}
